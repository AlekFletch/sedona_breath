<!--
  Screen 11 in steps: what the practice is, disclaimer, safety, consent. Centred by the frame, no list:
  a list on the watch keeps the row heights of the previous step.
-->
<stack class="root" onswipe="onSwipe">
  <image class="bg" src="{{ bg }}"></image>
  <div class="frame">
    <text class="title" if="{{ head !== '' }}">{{ head }}</text>
    <text class="body dlg-gap" style="height: {{ h1 }}px;" if="{{ t1 !== '' }}">{{ t1 }}</text>
    <text class="body dlg-gap" style="height: {{ h2 }}px;" if="{{ t2 !== '' }}">{{ t2 }}</text>
    <div class="btn-primary dlg-gap" onclick="next"><text class="btn-text-primary">{{ buttonText }}</text></div>
  </div>
</stack>
