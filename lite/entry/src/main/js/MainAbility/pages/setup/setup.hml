<!-- Screen 2: session setup; tap a card to cycle its value -->
<stack class="root" onswipe="onSwipe">
  <image class="bg" src="{{ bg }}"></image>
  <div class="frame">
    <list class="list" ref="list">
      <list-item class="li-title"><text class="title">{{ s.setup_title }}</text></list-item>
      <list-item class="li-card">
        <div class="card" onclick="nextDuration">
          <text class="label">{{ s.setup_duration }}</text>
          <text class="value">{{ durationText }}</text>
        </div>
      </list-item>
      <list-item class="li-card">
        <div class="card" onclick="toggleMode">
          <text class="label">{{ s.setup_mode }}</text>
          <text class="value">{{ modeText }}</text>
        </div>
      </list-item>
      <list-item class="li-card">
        <div class="card" onclick="nextPattern">
          <text class="label">{{ s.setup_pattern }}</text>
          <text class="value">{{ patternText }}</text>
        </div>
      </list-item>
      <list-item class="li-card">
        <div class="card" onclick="toggleVibration">
          <text class="label">{{ s.setup_vibration }}</text>
          <text class="value">{{ vibrationText }}</text>
        </div>
      </list-item>
      <list-item class="li">
        <div class="btn-primary" onclick="start"><text class="btn-text-primary">{{ s.btn_start }}</text></div>
      </list-item>
      <list-item class="li">
        <div class="btn" onclick="back"><text class="btn-text">{{ s.btn_back }}</text></div>
      </list-item>
      <list-item class="li-gap"></list-item>
    </list>
  </div>
</stack>
