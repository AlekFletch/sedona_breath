<!--
  Screens 4, 6, 7: intensity before, Sedona prompt, emotion, intensity after ("Free" / "Once more?"),
  completion message, and the pause / end / interruption dialog. Breathing is on pages/session.
  The first item centres a short screen vertically (topGap); a long one scrolls from the top.
-->
<stack class="root" onswipe="onSwipe">
  <image class="bg" src="{{ bg }}"></image>
  <div class="frame" if="{{ modal === 0 && screen !== '' }}">
    <list class="list" ref="list">
      <list-item class="li-text" style="height: {{ topGap }}px;" if="{{ topGap > 0 }}"></list-item>
      <list-item class="li-line" if="{{ counterText !== '' }}"><text class="accent">{{ counterText }}</text></list-item>
      <list-item class="li-text" style="height: {{ headR }}px;" if="{{ headText !== '' }}">
        <text class="big" style="height: {{ headH }}px;">{{ headText }}</text>
      </list-item>
      <list-item class="li-text" style="height: {{ bodyR }}px;" if="{{ bodyText !== '' }}">
        <text class="body" style="height: {{ bodyH }}px;">{{ bodyText }}</text>
      </list-item>
      <list-item class="li" if="{{ firstText !== '' }}">
        <div class="btn-primary" onclick="tapFirst"><text class="btn-text-primary">{{ firstText }}</text></div>
      </list-item>
      <list-item class="li" for="{{ options }}">
        <text class="opt" onclick="choose($item.id)">{{ $item.label }}</text>
      </list-item>
      <list-item class="li" if="{{ scale }}">
        <div class="rate-row">
          <div class="rate" onclick="rate(1)"><text class="rate-text">1</text></div>
          <div class="rate" onclick="rate(2)"><text class="rate-text">2</text></div>
          <div class="rate" onclick="rate(3)"><text class="rate-text">3</text></div>
          <div class="rate" onclick="rate(4)"><text class="rate-text">4</text></div>
          <div class="rate" onclick="rate(5)"><text class="rate-text">5</text></div>
        </div>
      </list-item>
      <list-item class="li-line" if="{{ scale }}">
        <div class="pair">
          <text class="scale-low">{{ s.checkin_low }}</text>
          <text class="scale-high">{{ s.checkin_high }}</text>
        </div>
      </list-item>
      <list-item class="li" if="{{ lastText !== '' }}">
        <div class="btn" onclick="tapLast"><text class="btn-text">{{ lastText }}</text></div>
      </list-item>
      <list-item class="li-gap"></list-item>
      <list-item class="li-round" if="{{ round === '1' }}"></list-item>
    </list>
  </div>
  <!-- Dialog last: when `modal` changes, the screen above is removed before the dialog is built,
       so the two never share the heap. -->
  <div class="frame" if="{{ modal > 0 }}">
    <text class="big" style="height: {{ dialogH }}px;">{{ dialogTitle }}</text>
    <text class="small" if="{{ dialogBody !== '' }}">{{ dialogBody }}</text>
    <div class="btn-primary dlg-gap" onclick="resume"><text class="btn-text-primary">{{ s.btn_resume }}</text></div>
    <div class="btn dlg-gap" if="{{ modal !== 2 }}" onclick="askEnd"><text class="btn-text">{{ s.btn_finish }}</text></div>
    <div class="btn dlg-gap" if="{{ modal === 2 }}" onclick="endNow"><text class="btn-text-danger">{{ s.btn_end_now }}</text></div>
    <div class="btn dlg-gap" if="{{ modal === 2 }}" onclick="endAndSave"><text class="btn-text-sm">{{ s.btn_end_save }}</text></div>
  </div>
</stack>
