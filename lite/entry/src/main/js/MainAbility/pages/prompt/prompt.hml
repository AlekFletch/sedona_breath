<!--
  Screens 4, 6, 7: Sedona prompt, emotion, check-in, completion message, and the pause / end /
  interruption dialog. Breathing is on pages/session.
-->
<stack class="root" onswipe="onSwipe">
  <image class="bg" src="{{ bg }}"></image>
  <div class="frame" if="{{ modal > 0 }}">
    <list class="list" ref="list">
      <list-item class="li-text" style="height: {{ dialogR }}px;">
        <text class="big" style="height: {{ dialogH }}px;">{{ dialogTitle }}</text>
      </list-item>
      <list-item class="li-line" if="{{ dialogBody !== '' }}"><text class="small">{{ dialogBody }}</text></list-item>
      <list-item class="li">
        <div class="btn-primary" onclick="resume"><text class="btn-text-primary">{{ s.btn_resume }}</text></div>
      </list-item>
      <list-item class="li" if="{{ modal !== 2 }}">
        <div class="btn" onclick="askEnd"><text class="btn-text">{{ s.btn_finish }}</text></div>
      </list-item>
      <list-item class="li" if="{{ modal === 2 }}">
        <div class="btn" onclick="endNow"><text class="btn-text-danger">{{ s.btn_end_now }}</text></div>
      </list-item>
      <list-item class="li" if="{{ modal === 2 }}">
        <div class="btn" onclick="endAndSave"><text class="btn-text">{{ s.btn_end_save }}</text></div>
      </list-item>
      <list-item class="li-gap"></list-item>
    </list>
  </div>
  <div class="frame" if="{{ modal === 0 }}">
    <list class="list" ref="list">
      <list-item class="li-line" if="{{ counterText !== '' }}"><text class="accent">{{ counterText }}</text></list-item>
      <list-item class="li-text" style="height: {{ headR }}px;" if="{{ headText !== '' }}">
        <text class="big" style="height: {{ headH }}px;">{{ headText }}</text>
      </list-item>
      <list-item class="li-text" style="height: {{ bodyR }}px;" if="{{ bodyText !== '' }}">
        <text class="body" style="height: {{ bodyH }}px;">{{ bodyText }}</text>
      </list-item>
      <list-item class="li" if="{{ firstText !== '' }}">
        <div class="btn-primary" onclick="tapFirst"><text class="btn-text-primary">{{ firstText }}</text></div>
      </list-item>
      <list-item class="li" for="{{ options }}">
        <div class="btn" onclick="choose($item.id)"><text class="btn-text">{{ $item.label }}</text></div>
      </list-item>
      <list-item class="li" if="{{ screen === 'checkIn' }}">
        <div class="rate-row">
          <div class="rate" onclick="rate(1)"><text class="rate-text">1</text></div>
          <div class="rate" onclick="rate(2)"><text class="rate-text">2</text></div>
          <div class="rate" onclick="rate(3)"><text class="rate-text">3</text></div>
          <div class="rate" onclick="rate(4)"><text class="rate-text">4</text></div>
          <div class="rate" onclick="rate(5)"><text class="rate-text">5</text></div>
        </div>
      </list-item>
      <list-item class="li-line" if="{{ screen === 'checkIn' }}">
        <div class="pair">
          <text class="scale-low">{{ s.checkin_low }}</text>
          <text class="scale-high">{{ s.checkin_high }}</text>
        </div>
      </list-item>
      <list-item class="li" if="{{ lastText !== '' }}">
        <div class="btn" onclick="tapLast"><text class="btn-text">{{ lastText }}</text></div>
      </list-item>
      <list-item class="li-gap"></list-item>
    </list>
  </div>
</stack>
