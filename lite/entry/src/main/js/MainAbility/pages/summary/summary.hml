<!-- Screen 8: Summary -->
<stack class="root" onswipe="onSwipe">
  <image class="bg" src="{{ bg }}"></image>
  <div class="frame">
    <list class="list" ref="list">
      <list-item class="li-title"><text class="title">{{ s.summary_title }}</text></list-item>
      <list-item class="li-card" for="{{ lines }}">
        <div class="card">
          <text class="label">{{ $item.label }}</text>
          <text class="value">{{ $item.value }}</text>
        </div>
      </list-item>
      <list-item class="li">
        <div class="btn-primary" onclick="save"><text class="btn-text-primary">{{ s.btn_save }}</text></div>
      </list-item>
      <list-item class="li-line" if="{{ status !== '' }}"><text class="warn">{{ status }}</text></list-item>
      <list-item class="li-gap"></list-item>
    </list>
  </div>
</stack>
