      }
    ],
    "js": [
      {
        "pages": [
          "pages/index/index",
          "pages/onboarding/onboarding",
          "pages/setup/setup",
          "pages/session/session",
          "pages/prompt/prompt",
          "pages/summary/summary",
          "pages/history/history",
          "pages/settings/settings"
        ],
        "name": ".MainAbility"
      }
    ]
  }
